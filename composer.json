{
  "name": "lm-commons/lmc-api-auth-oauth2",
  "description": "API Tools for Oauth 2 authentication of requests",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Firstname Lastname",
      "email": "email@example.com"
    }
  ],
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "lm-commons/lmc-api-auth": "1.0.x-dev",
    "mezzio/mezzio-authentication-oauth2": "^2.14"
  },
  "require-dev": {
    "laminas/laminas-coding-standard": "^3.1",
    "phpunit/phpunit": "^13.0",
    "psalm/plugin-phpunit": "^0.19.5",
    "vimeo/psalm": "^6.14"
  },
  "autoload": {
    "psr-4": {
      "Lmc\\Api\\Auth\\Oauth2\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LmcTest\\Api\\Auth\\Oauth2\\": "test/"
    }
  },
  "extra": {
    "laminas": {
      "config-provider": "Lmc\\Api\\Auth\\Oauth2\\ConfigProvider"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3.99"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@test"
    ],
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-clover ./build/logs/clover.xml",
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test-coverage-html": "phpunit --coverage-html ./build/html",
    "static-analysis": "psalm --shepherd --stats"
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/lm-commons/lmc-api-auth.git"
    }
  ]
}
